{
  "name": "@greekgod/desktop",
  "private": true,
  "version": "3.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "node scripts/prepare-sync-service.mjs && npm run build",
    "build:bundle:production-authority": "node scripts/prepare-sync-service.mjs && npm run build -- --mode production-authority",
    "prepare:sync-service": "node scripts/prepare-sync-service.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "npm run test:identity && npm run test:progress-analytics && npm run test:picker-ux && npm run test:weight-window && npm run test:training-time && npm run test:human-coach && npm run test:companion-memory && npm run test:companion-reactions && npm run test:dev-storage && npm run test:storage && npm run test:windows-lifecycle",
    "test:training-time": "node scripts/training-time-summary.test.mjs",
    "test:picker-ux": "node scripts/exercise-picker-ux.test.mjs && node scripts/program-builder.test.mjs",
    "test:weight-window": "node scripts/weight-window.test.mjs && node scripts/journal.test.mjs",
    "test:human-coach": "node --experimental-strip-types --test scripts/human-coach-storage.test.ts scripts/coach-proposal-review.test.ts",
    "test:companion-memory": "node --experimental-strip-types --test scripts/companion-memory-storage.test.ts",
    "test:companion-reactions": "node --experimental-strip-types --test scripts/companion-reactions.test.ts scripts/companion-product-ux.test.ts scripts/local-companion-model.test.ts && node scripts/managed-runtime.test.mjs",
    "test:human-coach:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "tauri:human-coach-smoke:build": "tauri build --debug --no-bundle --config src-tauri/tauri.human-coach-smoke.conf.json",
    "test:identity": "node --experimental-strip-types scripts/exercise-identity.test.ts",
    "test:progress-analytics": "node --experimental-strip-types scripts/progress-exposure-history.test.ts && node --experimental-strip-types --test scripts/coach-report-progress.test.ts",
    "test:dev-storage": "node scripts/development-storage-config.test.mjs",
    "test:storage": "node --experimental-strip-types --experimental-sqlite scripts/storage/run-storage-tests.ts",
    "test:windows-lifecycle": "node scripts/windows-lifecycle.test.mjs",
    "audit:store": "node --experimental-strip-types --experimental-sqlite scripts/live-store-audit.ts --read-only",
    "audit:production-storage-bundle": "node scripts/audit-production-storage-bundle.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features native-sqlite-authority --config src-tauri/tauri.dev.conf.json",
    "tauri:sqlite-smoke:build": "tauri build --debug --no-bundle --features native-sqlite-shadow --config src-tauri/tauri.native-sqlite-smoke.conf.json",
    "tauri:authority-smoke:build": "tauri build --debug --no-bundle --features native-sqlite-authority --config src-tauri/tauri.native-authority-smoke.conf.json",
    "tauri:authority-live-smoke:build": "tauri build --debug --no-bundle --features native-sqlite-authority --config src-tauri/tauri.native-authority-live-smoke.conf.json",
    "tauri:schema8-physical-smoke:build": "node scripts/prepare-sync-service.mjs && tauri build --debug --no-bundle --features native-sqlite-authority --config src-tauri/tauri.schema8-physical-smoke.conf.json",
    "tauri:rehearsal:build": "tauri build --debug --no-bundle --features native-sqlite-production-authority --config src-tauri/tauri.rehearsal.conf.json",
    "tauri:production-authority:build": "npm run tauri:build",
    "tauri:build": "tauri build --features native-sqlite-production-authority"
  },
  "dependencies": {
    "@greekgod/companion": "*",
    "@greekgod/human-coach": "*",
    "@greekgod/analytics": "*",
    "@greekgod/core": "*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
