{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GreekGod",
  "version": "3.0.0",
  "identifier": "com.igorpich.greekgod.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GreekGod",
        "width": 430,
        "height": 860,
        "minWidth": 320,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#090A0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "HealthAndFitness",
    "shortDescription": "Prywatny mobilny logger treningowy działający offline.",
    "android": {
      "minSdkVersion": 26
    }
  }
}
