{
  "name": "@greekgod/mobile",
  "private": true,
  "version": "3.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
