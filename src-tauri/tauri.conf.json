{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GreekGod",
  "version": "2.5.0",
  "identifier": "com.igorpich.formlog",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GreekGod",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Igor Pich",
    "category": "Healthcare and Fitness",
    "shortDescription": "GreekGod — prywatny dziennik treningowy",
    "longDescription": "Prywatny dziennik sylwetki i progresu treningowego działający bez internetu.",
    "copyright": "Copyright © 2026 Igor Pich",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["Polish", "English"],
        "startMenuFolder": "GreekGod"
      },
      "wix": {
        "language": ["pl-PL", "en-US"]
      }
    }
  }
}
